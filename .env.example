# Copy this file to .env and change the values.
# Never commit the real .env file.

# --- User on the host (run `id -u` and `id -g`) ---
HOST_UID=1000
HOST_GID=1000

# The API is open to the network. The others are on 127.0.0.1 only.
APP_PORT=8081
DB_HOST_PORT=3307
REDIS_HOST_PORT=6380
RABBITMQ_MANAGEMENT_PORT=15672
PHPMYADMIN_PORT=8080

# --- Laravel ---
APP_NAME=SensorIngestionSystem
APP_ENV=local
# Generate it with: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
# Keep false when the port is open to others. True returns stack traces in API errors.
APP_DEBUG=false
APP_URL=http://localhost:8081
LOG_CHANNEL=stderr
# Shared secret that the gateway sends in the X-Gateway-Token header.
GATEWAY_TOKEN=change-me
# The API rejects a packet whose timestamp is further ahead of server time than this.
INGRESS_MAX_FUTURE_SECONDS=300

# --- MariaDB ---
DB_DATABASE=sensor_ingestion
DB_USERNAME=sensor_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Redis ---
REDIS_PASSWORD=change-me

# --- RabbitMQ ---
RABBITMQ_USER=sensor_app
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
